-- =========================================================
-- 6. CURRENCY EXCHANGE
-- =========================================================

-- Sample
select *
from bronze.currencyexchange
limit 10;

-- Row Count
select count(*) as row_count
from bronze.currencyexchange;

-- Duplicate Keys
select
    "date",
    fromcurrency,
    tocurrency,
    count(*) as record_count
from bronze.currencyexchange
group by
    "date",
    fromcurrency,
    tocurrency
having count(*) > 1;

-- NULL Analysis
select
    count(*) filter (where "date" is null) as date_nulls,
    count(*) filter (where fromcurrency is null) as fromcurrency_nulls,
    count(*) filter (where tocurrency is null) as tocurrency_nulls,
    count(*) filter (where exchange is null) as exchange_nulls
from bronze.currencyexchange;

-- Blank Values
select
    count(*) filter (where trim(coalesce(fromcurrency, '')) = '') as blank_fromcurrency,
    count(*) filter (where trim(coalesce(tocurrency, '')) = '') as blank_tocurrency
from bronze.currencyexchange;

-- Negative Values
select
    count(*) filter (where exchange < 0) as negative_exchange
from bronze.currencyexchange;

-- Zero Values
select
    count(*) filter (where exchange = 0) as zero_exchange
from bronze.currencyexchange;

-- Distinct Values
select
    count(distinct "date") as distinct_date,
    count(distinct fromcurrency) as distinct_fromcurrency,
    count(distinct tocurrency) as distinct_tocurrency,
    count(distinct exchange) as distinct_exchange
from bronze.currencyexchange;

-- Min / Max
select
    min("date") as min_date,
    max("date") as max_date,
    min(exchange) as min_exchange,
    max(exchange) as max_exchange
from bronze.currencyexchange;

-- Data Types
select
    column_name,
    data_type
from information_schema.columns
where table_schema = 'bronze'
  and table_name = 'currencyexchange'
order by ordinal_position;
