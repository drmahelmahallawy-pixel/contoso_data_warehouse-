-- ==========================================
-- Product Data Profiling
-- ==========================================

-- 0. Sample Data
select *
from bronze.product
limit 10;


-- 1. Row Count
select count(*) as row_count
from bronze.product;


-- 2. Duplicate Keys
select
    productkey,
    count(*) as product_count
from bronze.product
group by productkey
having count(*) > 1;


-- 3. NULL Analysis
select
    count(*) filter (where productkey is null)  as productkey_nulls,
    count(*) filter (where productcode is null) as productcode_nulls,
    count(*) filter (where productname is null) as productname_nulls
from bronze.product;


-- 4. Blank Values
select
    count(*) filter (where productcode = '') as blank_productcode,
    count(*) filter (where productname = '') as blank_productname,
    count(*) filter (where trim(productcode) = '') as whitespace_productcode,
    count(*) filter (where trim(productname) = '') as whitespace_productname
from bronze.product;


-- 5. Negative Values
select
    count(*) filter (where productkey < 0) as negative_productkey
from bronze.product;


-- 6. Zero Values
select
    count(*) filter (where productkey = 0) as zero_productkey
from bronze.product;


-- 7. Distinct Values
select
    count(distinct productkey)  as distinct_productkey,
    count(distinct productcode) as distinct_productcode,
    count(distinct productname) as distinct_productname
from bronze.product;


-- 8. Min / Max
select
    min(productkey) as min_productkey,
    max(productkey) as max_productkey
from bronze.product;


-- 9. Data Types
select
    column_name,
    data_type
from information_schema.columns
where table_schema = 'bronze'
  and table_name = 'product'
order by ordinal_position;
------------------
select
    table_name
from information_schema.tables
where table_schema = 'bronze'
  and table_type = 'BASE TABLE'
order by table_name;
