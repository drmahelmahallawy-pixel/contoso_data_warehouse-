-- =========================================================
-- SILVER LAYER - SALES
-- =========================================================

create schema if not exists silver;

do $$
declare
    start_time timestamp;
    end_time timestamp;
begin

    start_time := clock_timestamp();

    raise notice '============================================';
    raise notice 'Silver.sales load started at: %', start_time;
    raise notice '============================================';

    -- Recreate Silver Table
    drop table if exists silver.sales;

    create table silver.sales as
    select
        orderkey,
        linenumber,
        orderdate,
        deliverydate,
        customerkey,
        storekey,
        productkey,
        quantity,
        unitprice,
        netprice,
        unitcost,
        currencycode,
        exchangerate,

        -- Derived Metrics
        quantity * netprice as revenue,
        quantity * unitcost as total_cost

    from bronze.sales;

    end_time := clock_timestamp();

    raise notice '============================================';
    raise notice 'Silver.sales load completed at: %', end_time;
    raise notice 'Execution time: % seconds',
        extract(epoch from (end_time - start_time));
    raise notice '============================================';

end $$;
