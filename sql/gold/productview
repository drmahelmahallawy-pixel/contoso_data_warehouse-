-- =========================================================
-- GOLD LAYER - DIM PRODUCT VIEW
-- =========================================================

create schema if not exists gold;

do $$
declare
    start_time timestamp;
    end_time timestamp;
begin

    start_time := clock_timestamp();

    raise notice '================================================';
    raise notice 'Gold.dim_product creation started at: %',
        start_time;
    raise notice '================================================';

    drop view if exists gold.dim_product;

    create view gold.dim_product as
    select
        productkey,
        productcode,
        productname,
        manufacturer,
        brand,
        color,
        weightunit,
        weight,
        categorykey,
        categoryname,
        subcategorykey,
        subcategoryname,
        cost,
        price
    from silver.product;

    end_time := clock_timestamp();

    raise notice 'Gold.dim_product view created at: %',
        end_time;

    raise notice 'Execution time: % seconds',
        extract(epoch from (end_time - start_time));

    raise notice '================================================';

end $$;
